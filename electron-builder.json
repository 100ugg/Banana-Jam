{
  "appId": "com.100ugg.bananajam",
  "productName": "Banana Jam",
  "electronVersion": "32.0.1",
  "directories": {
    "output": "build"
  },
  "win": {
    "icon": "./assets/images/icon.ico",
    "asar": true,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "icon": "./assets/images/icon.png",
    "asar": true,
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.games",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "./assets/images/icon.png",
    "asar": true,
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Game",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "nsis": {
    "artifactName": "BananaJam-Setup-${version}.${ext}",
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "installerIcon": "./assets/images/icon.ico",
    "uninstallerIcon": "./assets/images/icon.ico",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Banana Jam",
    "include": "build/installer.nsh",
    "warningsAsErrors": false,
    "guid": "e8a83ab5-c430-4afd-8915-396f4ea6d02e",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "files": [
    "**/*",
    "!**/*.{md,txt,pdf,docx}",
    "!data/**/*",
    "!ffdec-export/**/*",
    "!swf-edit/**/*",
    "!dev/**/*",
    "!build/**/*",
    "!scripts/**/*",
    "!installer/**/*",
    "!plugins/**/*",
    "!assets/client/**/*",
    "!*.{eslintignore,eslintrc,gitignore,gitattributes,editorconfig}"
  ],
  "extraFiles": [
    "settings.json",
    {
      "from": "plugins",
      "to": "plugins",
      "filter": [
        "**/*"
      ]
    }
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets",
      "filter": [
        "**/*",
        "!memory-bank/**/*",
        "!client/**/*",
        "!*-backup.asar",
        "!*-dev.asar",
        "!winapp.asar",
        "!osxapp.asar",
        "!**/*.bak",
        "!**/*-backup*",
        "!flash/ajclient-test*.swf",
        "!flash/ajclient-original.swf",
        "!**/*.tmp",
        "!**/*-copy*",
        "!**/temp_*",
        "!**/tmp_*"
      ]
    },
    {
      "from": "src/electron/clear-cache-helper.js",
      "to": "clear-cache-helper.js"
    }
  ]
}